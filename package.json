{
  "name": "daily-walk",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "dev": "npm run build:react && concurrently -k -n sass,react,web \"npm:watch:css\" \"npm:watch:react\" \"vite --host 127.0.0.1 --port 8123 --strictPort\"",
    "build:react": "vite build --config vite.react.config.mjs",
    "watch:react": "npm run build:react -- --watch",
    "build:css": "sass assets/scss/main.scss assets/css/styles.css --style=expanded --no-source-map",
    "watch:css": "sass --watch assets/scss/main.scss:assets/css/styles.css --style=expanded --no-source-map"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "concurrently": "^9.2.1",
    "sass": "^1.93.2",
    "vite": "^8.3.8"
  }
}
